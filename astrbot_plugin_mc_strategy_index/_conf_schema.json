{
    "admin_whitelist": {
        "description": "管理员白名单",
        "type": "list",
        "hint": "白名单用户拥有管理员权限。",
        "default": [],
        "items": {"type": "string"}
    },
    "notify_permission_denied": {
        "description": "无权限时发送提醒",
        "type": "bool",
        "hint": "关闭后静默忽略。",
        "default": true
    },
    "enable_image_edit": {
        "description": "启用图片编辑功能",
        "type": "bool",
        "hint": "关闭后巡检仅标记。",
        "default": false
    },
    "image_api_provider": {
        "description": "图片编辑API提供商",
        "type": "string",
        "hint": "openai / doubao。",
        "default": "openai"
    },
    "image_api_key": {
        "description": "图片编辑API密钥",
        "type": "string",
        "hint": "留空则不可用。",
        "default": ""
    },
    "image_api_base_url": {
        "description": "图片编辑API地址",
        "type": "string",
        "hint": "默认OpenAI地址。",
        "default": "https://api.openai.com"
    },
    "image_api_model": {
        "description": "图片编辑模型",
        "type": "string",
        "hint": "推荐 gpt-4o。",
        "default": "gpt-4o"
    },
    "max_image_size_kb": {
        "description": "图片大小上限(KB)",
        "type": "int",
        "hint": "默认 5120KB。",
        "default": 5120
    }
}
